        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>identifiers</IRI>
        <Literal xml:lang="en">Generally (unique) symbols or strings that provide a key to the given subject, often within some conventional scheme for generating and recognizing the token assigned.</Literal>
