        <Literal xml:lang="en">A Secondness</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:scopeNote"/>
        <IRI>adjunctual</IRI>
        <Literal xml:lang="en">Some of the concepts associated with this set of properties are birth, death, marriage, events, accidents, surprises, happenings, extrinsic, adjunctual.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:scopeNote"/>
        <IRI>adjunctual</IRI>
        <Literal xml:lang="en">Though Peirce used ‘accidental’ much (Eventuals), he applied it in most cases to ‘accidental actuals’; thus, ‘adjunct’ better captures potentiality.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
