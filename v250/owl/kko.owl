    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>adjunctual</IRI>
        <Literal xml:lang="en">These are events that may occur to a single entities or events (particulars) that help characterize it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>adjunctual</IRI>
