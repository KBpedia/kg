        <Literal xml:lang="en">These ae indirect references or pointers that help situate or draw attention to the subject.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>indexes</IRI>
