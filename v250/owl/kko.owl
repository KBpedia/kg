    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:scopeNote"/>
        <IRI>indexes</IRI>
        <Literal xml:lang="en">Some of the concepts associated with this set of properties are URIs, identifiers, keys, indices, references, semes, propositions (w/o objects), codes, selections, directional, citations, pronouns.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>intrinsics</IRI>
        <Literal xml:lang="en">Innate characteristics or essences of single entities or events (particulars).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>intrinsics</IRI>
        <Literal xml:lang="en">intrinsics</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:scopeNote"/>
        <IRI>intrinsics</IRI>
        <Literal xml:lang="en">A Firstness</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:scopeNote"/>
        <IRI>intrinsics</IRI>
        <Literal xml:lang="en">Some of the concepts associated with this set of properties are oneness, qualities, feelings, inherent, negation, is, has, intensional, naturalness, internal, innateness.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>intrinsicsData</IRI>
        <Literal xml:lang="en">Innate characteristics or essences of single entities or events (particulars).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
