    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>Values</IRI>
        <Literal xml:lang="en">The value of an attribute is any number, amount or other mathematical object assigned to it, computed for it, or implied by a function as a result of a particular number being assigned to its argument. Values may be strings or numbers, with magnitudes or multitudes possible for the numbers.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
